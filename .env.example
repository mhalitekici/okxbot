# Only demo keys created in OKX Demo Trading. Never paste live credentials.
OKX_DEMO=1
LIVE_TRADING_ENABLED=false
OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Optional dedicated demo names; provide all three together to override legacy demo names.
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
# Confirm only after verifying an exclusive bot account/sub-account. Required for auto-flatten.
DEDICATED_TRADING_ACCOUNT_CONFIRMED=false

TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Numeric, marked channel ID, for example -1001234567890; account must be a member.
TELEGRAM_CHANNEL_ID=-1003769687656
# Verified forum topic ID; 0 blocks new signals. This group's signal topic is 23576.
TELEGRAM_TOPIC_ID=23576
# Set to the same numeric ID only when the allowed channel is MZTRADINGBOT.
# 0 disables channel-specific direction interpretation.
MZTRADINGBOT_CHANNEL_ID=-1003769687656
# Prefer persistent session file created by telegram-session; optional string override.
TELEGRAM_SESSION_STRING=
TELEGRAM_SESSION_FILE=data/telegram.session-string
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
DATABASE_URL=postgresql+asyncpg://okx:replace-with-a-url-safe-random-password@localhost:5432/okx
# Legacy compatibility only; no longer sizes positions or narrows channel stops.
MAX_ACCOUNT_RISK_PERCENT=1
ALLOCATION_SLOTS=3
AUTO_REBALANCE=true
MAX_PORTFOLIO_RISK_PERCENT=40
MINIMUM_FREE_MARGIN=10
MAX_ORDER_SLIPPAGE_PERCENT=0.5
UNUSUAL_STOP_DISTANCE_PERCENT=5
LIQUIDATION_BUFFER_PERCENT=0.25
MAX_OPEN_POSITIONS=3
MAX_SIGNAL_AGE_SECONDS=60
MAX_ENTRY_PRICE_DEVIATION_PERCENT=0.5
MAX_BID_ASK_SPREAD_PERCENT=0.5
MAX_DAILY_LOSS_PERCENT=3
RECONCILIATION_INTERVAL_SECONDS=5
TELEGRAM_SCAN_INTERVAL_SECONDS=10
ORDER_POLL_ATTEMPTS=8
ORDER_POLL_INTERVAL_SECONDS=0.5
HTTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO

